# 커밋 리포트 메일 발송 설정 (예시)
# 이 파일을 복사해서 .claude/commit-report.env 로 만들고 실제 값을 채우세요.
#   cp .claude/commit-report.env.example .claude/commit-report.env
# .claude/commit-report.env 는 .gitignore 되어 커밋되지 않습니다. (비밀 안전)

# SMTP 서버
COMMIT_SMTP_HOST=smtp.uranushq.com
COMMIT_SMTP_PORT=587
# STARTTLS(587) 대신 SSL(465)을 쓰면 true 로:
COMMIT_SMTP_SSL=false

# 로그인 계정 / 비밀번호
COMMIT_SMTP_USER=bjw020615@uranushq.com
COMMIT_SMTP_PASS=여기에_비밀번호_또는_앱비밀번호

# 보내는 주소 / 받는 주소
COMMIT_MAIL_FROM=bjw020615@uranushq.com
COMMIT_MAIL_TO=bjw020615@uranushq.com

# ── 커밋 분석(Claude) 옵션 ───────────────────────────────
# 커밋마다 claude가 diff를 분석해 docs/DEV_LOG.md에 누적 + 메일 본문에 포함.
COMMIT_ANALYZE=1                 # 0/false 로 분석 끄기
COMMIT_ANALYZE_MODEL=opus        # opus | sonnet | haiku
# claude 실행파일 경로(PATH에 없을 때). 비우면 자동 탐지(~/.local/bin/claude.exe 등).
COMMIT_CLAUDE_BIN=
